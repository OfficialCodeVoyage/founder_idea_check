{
	"name": "founder-idea-check",
	"private": true,
	"packageManager": "bun@1.3.14",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OfficialCodeVoyage/founder_idea_check.git"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=20.9.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"worktree-env": "bun .agents/skills/worktree-ports/scripts/worktree-env.ts",
		"dev": "dotenv -e .env.worktree.local -e .env.local -- bun run worktree-env chat -- turbo run dev --filter=@chatjs/chat",
		"dev:local": "bash apps/chat/scripts/dev-local.sh",
		"dev:info": "dotenv -e .env.worktree.local -e .env.local -- bun run worktree-env --info",
		"build": "dotenv -e .env.local -- turbo run build",
		"fetch:models": "dotenv -e .env.local -- turbo run fetch:models --filter=@chatjs/chat",
		"test:e2e": "dotenv -e .env.worktree.local -e .env.local -- bun run worktree-env chat -- turbo run test:e2e --filter=@chatjs/chat",
		"format": "turbo run format",
		"lint": "turbo run lint",
		"clean:modules": "find . -name node_modules -type d -prune -exec rm -rf {} +",
		"test": "bun test ./.agents/skills/worktree-ports/scripts/worktree-runtime.test.ts && dotenv -e .env.worktree.local -e .env.local -- bun run worktree-env chat -- turbo run test",
		"test:unit": "bun test ./.agents/skills/worktree-ports/scripts/worktree-runtime.test.ts && turbo run test:unit",
		"test:types": "turbo run test:types",
		"verify": "bash scripts/verify.sh",
		"template:sync": "bun scripts/sync-template.ts",
		"template:check": "bun scripts/sync-template.ts --check",
		"chat-js": "bun --filter @chat-js/cli start",
		"db:generate": "dotenv -e .env.local -- bun --filter=@chatjs/chat run db:generate",
		"db:migrate": "dotenv -e .env.local -- bun --filter=@chatjs/chat run db:migrate",
		"db:push": "dotenv -e .env.local -- bun --filter=@chatjs/chat run db:push",
		"db:seed": "dotenv -e .env.local -- bun --filter=@chatjs/chat run db:seed",
		"db:branch:start": "dotenv -e .env.local -- bun --filter=@chatjs/chat run db:branch:start",
		"db:branch:stop": "dotenv -e .env.local -- bun --filter=@chatjs/chat run db:branch:stop",
		"start:chat": "dotenv -e .env.worktree.local -e .env.local -- bun run worktree-env chat -- bun --filter=@chatjs/chat run start"
	},
	"devDependencies": {
		"dotenv-cli": "^11.1.0",
		"turbo": "2.11.10"
	}
}
