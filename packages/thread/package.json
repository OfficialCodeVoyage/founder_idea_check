{
	"name": "@chatjs/thread",
	"version": "0.0.0",
	"private": true,
	"description": "Headless threaded chat engine for AI SDK UI messages",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/OfficialCodeVoyage/founder_idea_check.git",
		"directory": "packages/thread"
	},
	"homepage": "https://github.com/OfficialCodeVoyage/founder_idea_check/tree/main/packages/thread",
	"bugs": {
		"url": "https://github.com/OfficialCodeVoyage/founder_idea_check/issues"
	},
	"keywords": [
		"chatjs",
		"ai",
		"ai-sdk",
		"thread",
		"chat"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"bun": "./src/react.ts",
			"development": "./src/react.ts",
			"default": "./dist/react.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"README.md",
		"ARCHITECTURE.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && bun ./build.ts",
		"format": "biome check --write src test build.ts *.md package.json tsconfig.json tsconfig.build.json biome.jsonc",
		"lint": "biome check src test build.ts ARCHITECTURE.md package.json tsconfig.json tsconfig.build.json biome.jsonc",
		"prepublishOnly": "bun run build",
		"test": "bun test --pass-with-no-tests",
		"test:unit": "bun test --pass-with-no-tests",
		"test:types": "tsc -p tsconfig.json --noEmit"
	},
	"peerDependencies": {
		"@ai-sdk/react": "^3.0.0",
		"ai": "^6.0.304",
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"@ai-sdk/react": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@ai-sdk/react": "^3.0.326",
		"@biomejs/biome": "2.4.16",
		"@types/bun": "^1.3.12",
		"@types/react": "19.3.0",
		"@types/react-test-renderer": "19.3.1",
		"ai": "^6.0.323",
		"react": "19.3.1",
		"react-test-renderer": "19.3.1",
		"typescript": "6.0.2"
	}
}
