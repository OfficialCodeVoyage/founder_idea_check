{
  "extends": ["ultracite/core", "ultracite/react", "ultracite/next"],
  "files": {
    "includes": [
      "!.next",
      "!.devtools",
      "!node_modules",
      "!playwright-report",
      "!test-results",
      "!components/ui",
      "!components/ai-elements",
      "!components/streamdown",
      "!components/stick-to-bottom",
      "!lib/utils.ts",
      "!hooks/use-mobile.ts",
      /* drizzle-kit regenerates these on every `db:generate`; formatting them
         is a losing battle and the diff noise hides real migration changes. */
      "!lib/db/migrations/meta"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        /* Allow mixing interface and type — type is required for intersection/mapped types */
        "useConsistentTypeDefinitions": "off",
        /* A page that calls server-side tRPC must pass the request-time barrier
           first (`lib/request-session.ts::getRequestQueryClient`); a bare
           `getQueryClient()` lets the tRPC context's session lookup read the
           clock while prerendering. The overrides below list the only files
           allowed to take it directly. The patterns match the alias and any
           relative path ending in `trpc/server` (with or without `.tsx`); a
           sibling import inside `trpc/` (`./server`) is not matched. */
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/trpc/server", "**/trpc/server.tsx"],
                "importNamePattern": "getQueryClient",
                "message": "Use getRequestQueryClient from @/lib/request-session: it awaits connection() before server-side tRPC reads the session."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      /* `lib/request-session.ts` wraps it in the barrier; the (chat)
         layout reaches its prefetches through `getRequestSession`, which
         awaits the same barrier. */
      "includes": ["lib/request-session.ts", "app/(chat)/layout.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
